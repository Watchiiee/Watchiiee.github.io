---
// src/components/sections/Hero.astro
// 텍스트는 정적 HTML로 렌더링하고, 3D 배경(ParticleWave)만 클라이언트에서 로드
import ParticleWave from "@/components/ParticleWave";
import ScrollIndicator from "@/components/ScrollIndicator";
---

<script is:inline>
  // 인트로("Watchiiee" 파티클) 재생 여부를 그리기 전에 결정해서, Hero 텍스트가 먼저 보였다 사라지는 깜빡임을 막음
  // 같은 탭에서 이미 봤거나, 움직임 최소화 설정이거나, 스크롤된 채로 열었거나, WebGL이 없으면 생략
  (function () {
    try {
      var root = document.documentElement;
      if (sessionStorage.getItem("introPlayed")) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (window.scrollY > window.innerHeight * 0.5) return;
      var gl = document.createElement("canvas");
      if (!(gl.getContext("webgl2") || gl.getContext("webgl"))) return;
      sessionStorage.setItem("introPlayed", "1");
      root.classList.add("intro-pending");
      // 스크립트 로딩 실패 등으로 인트로가 끝나지 않아도 텍스트는 반드시 보이도록
      setTimeout(function () {
        root.classList.remove("intro-pending");
      }, 9000);
    } catch (e) {}
  })();
</script>

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#0a192f] text-white"
>
  <ParticleWave client:only="react" />

  {/* 텍스트 가독성을 위한 중앙 비네팅 + 다음 섹션으로 자연스럽게 이어지는 하단 그라데이션 */}
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(10,25,47,0.8)_0%,rgba(10,25,47,0)_65%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-gradient-to-b from-transparent to-[#0a192f]"
  >
  </div>

  <div class="hero-intro-fade relative z-10 container mx-auto px-6 text-center">
    <h1
      class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight mb-4 uppercase"
    >
      Jung MyeongSeong
    </h1>
    <h2
      class="text-xl md:text-2xl font-semibold text-cyan-400 mb-8 tracking-[0.2em] uppercase"
    >
      Full-Stack Developer
    </h2>
    <p
      class="text-slate-300 text-base md:text-lg leading-relaxed max-w-xl mx-auto mb-10 break-keep"
    >
      화면부터 서버, 클라우드 인프라까지<br class="hidden md:block" />
      서비스 전체를 직접 설계하고 배포하는 풀스택 개발자입니다.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#projects"
        class="px-6 py-3 rounded-full bg-cyan-400 text-[#0a192f] font-semibold hover:bg-cyan-300 transition-colors"
      >
        프로젝트 보기
      </a>
      <a
        href="#expertise"
        class="px-6 py-3 rounded-full border border-slate-500 text-slate-200 font-semibold hover:border-cyan-400 hover:text-cyan-400 transition-colors"
      >
        My Expertise
      </a>
      <a
        href="#resume"
        class="px-6 py-3 rounded-full border border-slate-500 text-slate-200 font-semibold hover:border-cyan-400 hover:text-cyan-400 transition-colors"
      >
        Resume
      </a>
      <a
        href="#contact"
        class="px-6 py-3 rounded-full border border-slate-500 text-slate-200 font-semibold hover:border-cyan-400 hover:text-cyan-400 transition-colors"
      >
        Contact
      </a>
      <a
        href="https://github.com/Watchiiee"
        target="_blank"
        rel="noreferrer"
        class="px-6 py-3 rounded-full border border-slate-500 text-slate-200 font-semibold hover:border-cyan-400 hover:text-cyan-400 transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>

  <div class="hero-intro-fade-only">
    <ScrollIndicator />
  </div>
</section>

<style is:global>
  /* 인트로 동안 Hero 텍스트를 숨겼다가, 파티클 글자가 풀릴 때 부드럽게 드러냄 */
  .hero-intro-fade {
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }
  .intro-pending .hero-intro-fade {
    opacity: 0;
    transform: translateY(12px);
  }
  /* 스크롤 표시는 absolute 배치라 transform 없이 투명도만 조절 */
  .hero-intro-fade-only {
    transition: opacity 0.9s ease 0.3s;
  }
  .intro-pending .hero-intro-fade-only {
    opacity: 0;
  }
</style>
