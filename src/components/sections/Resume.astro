---
// src/components/sections/Resume.astro
import { Award, BadgeCheck, Languages, Shield } from "lucide-react";

// 학력·교육·활동 타임라인 (최신순)
const timeline = [
  {
    period: "2026.07",
    type: "교육",
    title: "생성형 AI 에이전트 이론 및 프로젝트 실습 교육",
    org: "가천대학교 / 업스테이지",
    projects: ["SafetyTrip"],
  },
  {
    period: "2026.06 ~ 2026.07",
    type: "교육",
    title: "[기업 멘토링] 현장 미러형 실무 프로젝트",
    org: "가천대학교 (멘토: 씨엠티정보통신)",
    projects: ["AiAn"],
  },
  {
    period: "2026.06",
    type: "교육",
    title: "네이버클라우드 아카데미",
    org: "네이버클라우드",
    projects: ["LostOnCampus"],
  },
  {
    period: "2026.02",
    type: "활동",
    title: "ISeeU 간호 임상 실습 플랫폼 프론트엔드 개발",
    org: "가천대학교 소프트웨어학과 연구실",
    projects: ["ISeeU"],
  },
  {
    period: "2025.09 ~ 2025.12",
    type: "교육",
    title: "가천대 카카오엔터프라이즈 SW 아카데미",
    org: "가천대학교 / 카카오엔터프라이즈",
    projects: ["G.O.A.T", "WhyNot?"],
  },
  {
    period: "2021.03 ~ 재학 중",
    type: "학력",
    title: "가천대학교 IT융합대학 AI·소프트웨어학부 (소프트웨어전공)",
    org: "2027.02 졸업 예정 · 경기 성남 · 학점 4.08 / 4.5",
    projects: [],
  },
];

const typeColor: Record<string, string> = {
  학력: "text-cyan-300 bg-cyan-900/40",
  교육: "text-blue-300 bg-blue-900/40",
  활동: "text-emerald-300 bg-emerald-900/40",
};

// 오른쪽 카드 영역
const groups = [
  {
    icon: Award,
    color: "text-orange-400",
    title: "Awards",
    items: [
      { date: "2026.06", name: "가천인재상", org: "가천대학교" },
      { date: "2026.02", name: "학습공동체 우수상", org: "가천대학교" },
      {
        date: "2025.12",
        name: "SW 아카데미 표창장",
        org: "가천대학교 / 카카오엔터프라이즈",
      },
      { date: "2021.04", name: "창의 Ntree 우수상", org: "가천대학교" },
    ],
  },
  {
    icon: BadgeCheck,
    color: "text-pink-400",
    title: "Certifications",
    items: [
      {
        date: "2026.07",
        name: "NAVER Cloud Platform Expert (NCE AI)",
        org: "네이버클라우드",
      },
      { date: "2026.06", name: "정보처리기사", org: "한국산업인력공단" },
      { date: "2024.08", name: "한국사능력검정시험 2급", org: "국사편찬위원회" },
    ],
  },
  {
    icon: Languages,
    color: "text-emerald-400",
    title: "Language",
    items: [
      { date: "2023.01", name: "JLPT N3 (129 / 180)", org: "일본국제교류기금" },
    ],
  },
  {
    icon: Shield,
    color: "text-slate-300",
    title: "Military Service",
    items: [
      {
        date: "2022.03 ~ 2023.09",
        name: "육군 병장 (대형차운전병)",
        org: "군필",
      },
    ],
  },
];
---

<section id="resume" class="py-24 bg-[#0a192f] text-white">
  <div class="container mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Resume</h2>
      <p class="text-slate-400 max-w-2xl text-lg leading-relaxed break-keep">
        학업과 교육, 실무 프로젝트를 거치며 쌓아온 경험입니다.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      {/* 타임라인 */}
      <ol class="lg:col-span-3 relative border-l border-slate-700 ml-2">
        {
          timeline.map((item) => (
            <li class="relative pl-8 pb-10 last:pb-0">
              <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-cyan-400 ring-4 ring-[#0a192f]" />
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="font-mono text-sm text-cyan-400">
                  {item.period}
                </span>
                <span
                  class={`px-2 py-0.5 rounded text-xs ${typeColor[item.type]}`}
                >
                  {item.type}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-100 break-keep">
                {item.title}
              </h3>
              <p class="text-sm text-slate-400 mt-1 break-keep">{item.org}</p>
              {item.projects.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {item.projects.map((name) => (
                    <a
                      href="#projects"
                      class="px-2 py-0.5 rounded border border-slate-600 text-xs text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition-colors"
                    >
                      → {name}
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ol>

      {/* 수상·자격·어학·병역 */}
      <div class="lg:col-span-2 space-y-6">
        {
          groups.map(({ icon: Icon, color, title, items }) => (
            <div class="p-6 border border-slate-700 bg-[#112240]/50">
              <h3 class="flex items-center gap-2 text-lg font-bold mb-4">
                <Icon className={`w-5 h-5 ${color}`} />
                {title}
              </h3>
              <ul class="space-y-3">
                {items.map((it) => (
                  <li class="flex gap-4">
                    <span class="font-mono text-xs text-slate-500 pt-1 shrink-0 w-[4.5rem]">
                      {it.date.split(" ~ ")[0]}
                    </span>
                    <div class="min-w-0">
                      <p class="text-slate-200 break-keep">{it.name}</p>
                      <p class="text-xs text-slate-500 break-keep">
                        {it.date.includes("~") ? `${it.date} · ` : ""}
                        {it.org}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
