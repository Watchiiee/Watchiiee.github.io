---
import Layout from '../layouts/Layout.astro';
import Logo from '@/components/Logo';
import Hero from '@/components/sections/Hero.astro';
import Expertise from '@/components/sections/Expertise';
import Projects from '@/components/sections/Projects';
import Resume from '@/components/sections/Resume.astro';
import Contact from '@/components/sections/Contact.astro';
import '@/styles/global.css';
---

<Layout title="정명성 | Full-Stack Developer">
  <Logo client:load />

  <main class="bg-[#0a192f]">
    <Hero />
    <Expertise client:visible />
    <Projects client:visible />
    <Resume />
    <Contact />
  </main>
  
  <footer class="py-10 text-center text-gray-500 text-sm border-t border-gray-800 bg-[#0a192f]">
    © 2026 Jung MyeongSeong. All rights reserved.
  </footer>
</Layout>